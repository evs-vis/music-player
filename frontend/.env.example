# 前端环境变量模板（复制为 .env.local 使用）
# Vite 环境变量以 VITE_ 前缀暴露给客户端代码（import.meta.env.VITE_*）

# 后端接口地址：留空则走同源 /api，由 vite dev/preview 的 proxy 转发到 http://localhost:3000
# 生产部署时指向线上后端，例如 https://api.example.com
VITE_API_BASE_URL=

# 可选：web-vitals 性能打点地址（perf.js 用 navigator.sendBeacon 上报），留空则仅 console + localStorage
VITE_PERF_ENDPOINT=
