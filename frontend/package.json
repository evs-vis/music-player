    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vant/auto-import-resolver": "^1.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.73.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "~10.9.2",
    "globals": "^17.7.0",
    "husky": "^8.0.0",
    "lint-staged": "^17.2.0",
