# 后端环境变量模板（本包未引入 dotenv，通过启动命令/平台注入读取，例如：
#   JWT_SECRET=xxx node server.js
#   Render/Railway 等平台在环境变量面板配置）

# JWT 签名密钥：生产必须设置强随机密钥；未设置时回退内置开发密钥（见 config.js）
JWT_SECRET=please-set-a-long-random-secret

# CORS 白名单：默认已含 http://localhost:5173，此处以逗号分隔追加额外来源
CORS_ORIGINS=http://localhost:5174,http://localhost:4173
